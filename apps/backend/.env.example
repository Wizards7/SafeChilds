# Dev Postgres from docker-compose.yml at the repo root
DATABASE_URL=postgres://safechilds:safechilds@localhost:5434/safechilds
# Comma-separated origins allowed to call the API (the mobile app's origin)
CORS_ORIGINS=http://localhost:3000
PORT=4100
# Optional until the demo: without it, image analysis returns the "unavailable" tier and everything else works
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Blocklists for the link check. Both optional; a list without a key is shown as "не проверено".
# Google Safe Browsing Lookup API v4 key (Google Cloud console → enable "Safe Browsing API" → API key)
SAFE_BROWSING_API_KEY=
# abuse.ch URLhaus Auth-Key (free, https://auth.abuse.ch/)
URLHAUS_AUTH_KEY=
